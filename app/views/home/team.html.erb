<!DOCTYPE html>
<html lang="en">
<head>
<link href="https://fonts.googleapis.com/css2?family=Jura:wght@400;700&display=swap" rel="stylesheet">

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Team - PharosAI</title>
  <%= stylesheet_link_tag "landing", "data-turbo-track": "reload" %>

</head>
<body>
  <!-- Video Background -->
  <div class="video-background">
    <video autoplay muted loop preload="auto" id="background-video">
      <source src="/videos/iStock-1483562425.mp4" type="video/mp4">
      Your browser does not support the video tag.
    </video>
  </div>

  <!-- Header with Logo -->
  <header>
    <div class="logo-container">
      <a href="<%= root_path %>">
        <img src="<%= image_path('pharos_logo_white2.png') %>" alt="PharosAI Logo" class="logo">
      </a>
      <a href="<%= root_path %>" class="logo-text-link"><span class="logo-text">PharosAI</span></a>
    </div>
    <nav class="header-nav">
      <%= link_to "About", about_path, class: "nav-link" %>
      <%= link_to "Team", team_path, class: "nav-link" %>
      <%= link_to "Contact", contact_path, class: "nav-link" %>
      <div class="social-icons">
        <a href="https://www.linkedin.com/company/pharosai" target="_blank">
          <img src="<%= image_path('linkedin2.png') %>" alt="LinkedIn" class="linkedin-icon">
        </a>
      </div>
    </nav>
  </header>

  <!-- Main Content -->
  <div class="page-content">
    <h1>Our Team</h1>
    <div class="team-grid">
      <div class="team-member">
        <div class="team-photo">
          <img src="<%= image_path('anita.jpg') %>" alt="Anita Grigoriads">
        </div>
        <div class="team-name-container">
          <h3 class="team-name">Anita Grigoriads</h3>
          <a href="https://www.linkedin.com/in/anita-grigoriadis-54555918/" target="_blank" class="team-linkedin">
            <img src="<%= image_path('linkedin2.png') %>" alt="LinkedIn" class="linkedin-icon">
          </a>
        </div>
        <p class="team-title">Chief Executive Officer</p>
      </div>
      <div class="team-member">
        <div class="team-photo">
          <img src="<%= image_path('louise.jpg') %>" alt="J.Louise Jones">
        </div>
        <div class="team-name-container">
          <h3 class="team-name">J.Louise Jones</h3>
          <a href="https://www.linkedin.com/in/j-louise-jones-09a968349/" target="_blank" class="team-linkedin">
            <img src="<%= image_path('linkedin2.png') %>" alt="LinkedIn" class="linkedin-icon">
          </a>
        </div>
        <p class="team-title">Chief Scientific Officer</p>
      </div>
      <div class="team-member">
        <div class="team-photo">
          <img src="<%= image_path('greg.jpg') %>" alt="Greg Verghese">
        </div>
        <div class="team-name-container">
          <h3 class="team-name">Greg Verghese</h3>
          <a href="https://www.linkedin.com/in/gregory-verghese-95311262/" target="_blank" class="team-linkedin">
            <img src="<%= image_path('linkedin2.png') %>" alt="LinkedIn" class="linkedin-icon">
          </a>
        </div>
        <p class="team-title">Chief Technology Officer</p>
      </div>
      <div class="team-member">
        <div class="team-photo">
          <img src="<%= image_path('lucie.jpg') %>" alt="Lucie Burgess">
        </div>
        <div class="team-name-container">
          <h3 class="team-name">Lucie Burgess</h3>
          <a href="https://www.linkedin.com/in/dr-lucie-c-burgess-0137299/" target="_blank" class="team-linkedin">
            <img src="<%= image_path('linkedin2.png') %>" alt="LinkedIn" class="linkedin-icon">
          </a>
        </div>
        <p class="team-title">Chief Operating Officer</p>
      </div>
      <div class="team-member">
        <div class="team-photo">
          <img src="<%= image_path('claude.jpg') %>" alt="Claude Chalala">
        </div>
        <div class="team-name-container">
          <h3 class="team-name">Claude Chalala</h3>
          <a href="https://www.linkedin.com/in/claude-chelala-62779970/" target="_blank" class="team-linkedin">
            <img src="<%= image_path('linkedin2.png') %>" alt="LinkedIn" class="linkedin-icon">
          </a>
        </div>
        <p class="team-title">Director of Biobanking</p>
      </div>
      <div class="team-member">
        <div class="team-photo">
          <img src="<%= image_path('maj.jpg') %>" alt="Majid Kazmi">
        </div>
        <div class="team-name-container">
          <h3 class="team-name">Majid Kazmi</h3>
          <a href="https://www.linkedin.com/in/majid-kazmi-72134b213/" target="_blank" class="team-linkedin">
            <img src="<%= image_path('linkedin2.png') %>" alt="LinkedIn" class="linkedin-icon">
          </a>
        </div>
        <p class="team-title">Chief Commercial Officer</p>
      </div>
    </div>
  </div>
</body>
</html>

