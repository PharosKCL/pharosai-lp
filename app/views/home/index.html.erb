<!DOCTYPE html>
<html lang="en">
<head>
<link href="https://fonts.googleapis.com/css2?family=Jura:wght@400;700&display=swap" rel="stylesheet">

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PharosAI</title>
  <%= stylesheet_link_tag "landing", "data-turbo-track": "reload" %>

</head>
<body>
  <!-- Video Background -->
  <div class="video-background">
    <video autoplay muted loop preload="auto" id="background-video">
      <source src="/videos/iStock-1483562425.mp4" type="video/mp4">
      Your browser does not support the video tag.
    </video>
  </div>

  <!-- Header with Logo -->
  <header>
    <div class="logo-container">
      <a href="<%= root_path %>">
        <img src="<%= image_path('pharos_logo_white2.png') %>" alt="PharosAI Logo" class="logo">
      </a>
      <a href="<%= root_path %>" class="logo-text-link"><span class="logo-text">PharosAI</span></a>
    </div>
    <nav class="header-nav">
      <%= link_to "About", about_path, class: "nav-link" %>
      <%= link_to "Team", team_path, class: "nav-link", data: { turbo_preload: true } %>
      <%= link_to "Contact", contact_path, class: "nav-link" %>
      <div class="social-icons">
        <a href="https://www.linkedin.com/company/pharosai" target="_blank">
          <img src="<%= image_path('linkedin2.png') %>" alt="LinkedIn" class="linkedin-icon">
        </a>
      </div>
    </nav>
  </header>

  <!-- Main Content Section -->
  <div class="middle-section">
    <div class="middle-text">
      <span id="typing-text"></span>
    </div>
  </div>


<div class="partner-section">
  <h2>Our Partners</h2>
  <div class="partners-logos">
    <img src="<%= image_path('kings.png') %>" alt="Partner 1" class="partner-logo partner-logo-small">
    <img src="<%= image_path('barts.png') %>" alt="Partner 2" class="partner-logo partner-logo-small">
    <img src="<%= image_path('Guys.webp') %>" alt="Partner 3" class="partner-logo">
    <img src="<%= image_path('qmul_new.png') %>" alt="Partner 4" class="partner-logo">
    <img src="<%= image_path('khp.webp') %>" alt="Partner 3" class="partner-logo">
    <img src="<%= image_path('Dawn.png') %>" alt="Partner 4" class="partner-logo">
  </div>
</div>

<div class="footer-section">
  <div class="copyright">
    <p>© 2024 King's College London. All rights reserved.</p>
  </div>
</div>

  <!-- JavaScript -->
  <%= javascript_importmap_tags "typing" %>
</body>
</html>
